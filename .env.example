# Copy this file to .env.local for local dev, and set the same variables
# in the Vercel project settings for production.
#
# Without RESEND_API_KEY/CONTACT_TO_EMAIL set, the contact form falls back
# to console.log in dev instead of actually sending an email.

# Resend API key — sign up at https://resend.com, create a key.
RESEND_API_KEY=re_your_api_key_here

# Where contact-form submissions get sent (your own inbox).
CONTACT_TO_EMAIL=your_email@example.com

# Cloudflare Turnstile — sign up at https://dash.cloudflare.com (free),
# add a Turnstile site, and copy its site key + secret key.
# Without these set, Turnstile verification is skipped (contact form still
# works, just without bot protection) — set both before going to production.
#
# Site key is exposed to the browser (NEXT_PUBLIC_ prefix required by
# Next.js for client-side env vars); secret key stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x_your_site_key_here
TURNSTILE_SECRET_KEY=0x_your_secret_key_here
