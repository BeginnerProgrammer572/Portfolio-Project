# Copy this file to .env.local for local dev, and set the same two
# variables in the Vercel project settings for production.
#
# Without these set, the contact form falls back to console.log in dev
# instead of actually sending an email.

# Resend API key — sign up at https://resend.com, create a key.
RESEND_API_KEY=re_your_api_key_here

# Where contact-form submissions get sent (your own inbox).
CONTACT_TO_EMAIL=1bryansobalvarro@gmail.com
